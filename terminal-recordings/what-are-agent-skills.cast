[0.017, "o", "\u001b[?2026h\r\u001b[27A  \u001b[1m### \u001b[m\u001b[1m3. Structure of a\u001b[m\u001b[1m Skill\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J\n  A typical skill lives as a directory (for example, inside \u001b[94m.agents/skills/<skill-name>/\u001b[m):\n\n\u001b[86D\u001b[38;5;252mskills/<skill-name>/\u001b[m\n\u001b[20D\u001b[38;5;252m├── SKILL.md \u001b[9b# Entry point: metadata + step-by-step instructions\u001b[m\n\u001b[73D\u001b[38;5;252m├── scripts/ \u001b[9b# Optional: Executable scripts/tools for complex commands\u001b[m\n\u001b[79D\u001b[38;5;252m├── references/ \u001b[6b# Optional: In-depth documentation loaded only when needed\u001b[m\n\u001b[80D\u001b[38;5;252m├── examples/ \u001b[8b# Optional: Code snippets or reference implementations\u001b[m\n\u001b[76D\u001b[38;5;252m└── resources/ \u001b[7b# Optional: Assets, templates, or schemas\u001b[m\r\n\n  \u001b[1m#### Example \u001b[94mSKILL.md\u001b[39m:\u001b[m\n\n\u001b[20D\u001b[38;5;68;4m---\u001b[m\n\b\b\b\u001b[38;5;70;1mname\u001b[38;5;252;22m:\u001b[38;5;241m \u001b[38;5;252mdeploy-preview-env\u001b[m\n\u001b[24D\u001b[38;5;70;1mdescription\u001b[38;5;252;22m:\u001b[38;5;241m \u001b[38;5;252m>-\u001b[m\n\u001b[15D\u001b[38;5;214m  Use this skill when the user asks to create or deploy a preview environment for testin"]
[0.000, "o", "g.\u001b[m\n\u001b[90D\u001b[38;5;68;4m---\u001b[m\n\n\b\b\b\u001b[38;5;231;1m# Deploy Preview Environment\u001b[m\n\n\u001b[28D\u001b[38;5;252mFollow these steps to deploy a temporary preview environment:\u001b[m\n\u001b[61D\u001b[38;5;70;1m1.\u001b[38;5;252;22m Run \u001b[38;5;214m`./scripts/verify-creds.sh`\u001b[38;5;252m.\u001b[m\n\u001b[35D\u001b[38;5;70;1m2.\u001b[38;5;252;22m Generate the preview stack with \u001b[38;5;214m`pulumi up --stack preview`\u001b[38;5;252m.\u001b[m\n\u001b[63D\u001b[38;5;70;1m3.\u001b[38;5;252;22m Check\u001b[m\r\n⡿  \u001b[94mLo\u001b[90mading...\u001b[m\r\n\u001b[90m└ Tip: Use /voice (or press f5) to record your prompt with your microphone.\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m──────────────────────────────────────"]
