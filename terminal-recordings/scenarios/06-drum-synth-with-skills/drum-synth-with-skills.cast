[0.000, "o", "/drum_synth/main.cpp#L303-L417\u0007AudioCallback\u001b[m\u001b]8;;\u0007 without runtime heap allocations or unstable runaway\r\n  resonances:\r\n\n   Voice Index | Name |\u001b[14X\u001b[14CEngine\u001b[15X\t\t  | Synthesis Method & Characteristics\r\n  -\u001b[12b|-\u001b[5b|-\u001b[34b|-\u001b[53b\r\n\t\u001b[1m0\u001b[m \u001b[5b|  \u001b[94mBD\u001b[m  | \u001b[8b\u001b[34;4m\u001b]8;id=jk8a9bc37b38056f79;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthbassdrum.h#L87\u0007SyntheticBassDrum\u001b[m\u001b]8;;\u0007 \u001b[8b| 909-style bass drum with distorted sine shaper,\n\u001b[92D| \u001b[5b|\u001b[35X\u001b[35C| punchy pitch sweep envelope, and rich odd harmonics\n\u001b[96D| \u001b[5b|\u001b[35X\u001b[35C| that cut through the internal speakers.\r\n\t\u001b[1m1\u001b[m \u001b[5b|  \u001b[94mSD\u001b[m  | \u001b[7b\u001b[34;4m\u001b]8;id=jke3655c1703515f2;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthsnaredrum.h#L34\u0007SyntheticSnareDrum\u001b[m\u001b]8;;\u0007 \u001b[8b| Dual-oscillator core with 1.47 mode ratio coupled\n\u001b[94D| \u001b[5b|\u001b[35X\u001b[35C| with snappy bandpass-filtered noise.\r\n\t\u001b[1m2\u001b[m \u001b[5b|  \u001b[94mCH\u001b[m  |\u001b[15X\u001b[15C\u001b[34;4m\u001b]8;id=jk90c6c6ed3c19dbb0;file:///Use"]
