[0.017, "o", "\u001b[?2026h\r\u001b[27A        \u001b[1m0\u001b[m      |  \u001b[94mBD\u001b[m  | \u001b]8;id=jk7408fab93925ad59;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthbassdrum.h#L87\u001b\\\u001b[4;34;4mS\u001b[m\u001b[4;34;4my\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mh\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4mB\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mD\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mu\u001b[m\u001b[4;34;4mm\u001b[m\u001b]8;;\u001b\\  | 909-style bass drum with distorted sine shaper, punchy pitch sweep\u001b[K\r\n\u001b[?5W\u001b[J\u001b[15C| \u001b[5b|\u001b[20X\u001b[20C| envelope, and rich odd harmonics that cut through the internal\n\u001b[92D| \u001b[5b|\u001b[20X\u001b[20C| speakers.\r\n\t\u001b[1m1\u001b[m \u001b[5b|  \u001b[94mSD\u001b[m  | \u001b[34;4m\u001b]8;id=jke79c542b38338852;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthsnaredrum.h#L34\u0007SyntheticSnareDrum\u001b[m\u001b]8;;\u0007 | Dual-oscillator core with 1.47 mode ratio coupled with snappy\n\u001b[91D| \u001b[5b|\u001b[20X\u001b[20C| bandpass-filtered noise.\r\n\t\u001b[1m2\u001b[m \u001b[5b|  \u001b[94mCH\u001b[m  | \u001b[6b\u001b[34;4m\u001b]8;id=jkc50cb87f59ddab90;file:///Users/brett/tmp/drum-synth-with-"]
[0.000, "o", "skills/workspace/DaisySP/Source/Drums/hihat.h#L117\u0007HiHat\u001b[m\u001b]8;;\u0007 \u001b[7b| 6-oscillator Schmitt trigger metallic cluster with tight decay.\n\u001b[93D| \u001b[5b|\u001b[20X\u001b[20C| Chokes open hat.\r\n\t\u001b[1m3\u001b[m \u001b[5b|  \u001b[94mOH\u001b[m  | \u001b[6b\u001b[34;4m\u001b]8;id=jkc50cc77f59ddc50d;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/hihat.h#L117\u0007HiHat\u001b[m\u001b]8;;\u0007 \u001b[7b| Open metallic hi-hat sizzle. Automatically choked when Closed Hat\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| (\u001b[94mCH\u001b[m) is triggered.\r\n\t\u001b[1m4\u001b[m \u001b[5b|  \u001b[94mLT\u001b[m  | \u001b[5b\u001b[34;4m\u001b]8;id=jk2847a7c766c201f3;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u0007TomVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Swept-sine low tom (88 Hz root) with 45 ms exponential pitch drop\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| and cubic body saturation.\r\n\t\u001b[1m5\u001b[m \u001b[5b|  \u001b[94mHT\u001b[m  | \u001b[5b\u001b[34;4m\u001b]8;id=jk33df6ad39bc0bac1;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u0007TomVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Swept-sine high tom (160 Hz root) with fast pitch drop and snappy\n\u001b[95D| \u001b[5"]
[0.000, "o", "b|\u001b[20X\u001b[20C| transient.\r\n\t\u001b[1m6\u001b[m \u001b[5b|  \u001b[94mCP\u001b[m  | \u001b[4b\u001b[34;4m\u001b]8;id=jk9255797c03c47495;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L98-L186\u0007ClapVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Analog 808-style handclap: 3 distinct 11 ms noise bursts followed\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| by a 190 ms reverb tail through an 1150 Hz bandpass filter.\r\n  ──────\r\n  \u001b[1m### Hardware Control Mappings\u001b[m\r\n\n  \u001b[1m#### 1. Front Keys (7 Note Keys + 7 Chord Keys)\u001b[m\r\n\n  • \u001b[1mLeft Grid (Note Keys \u001b[94;22mN1\u001b[39;1m–\u001b[94;22mN7\u001b[39;1m)\u001b[m: Triggers Voices 0–6 at normal velocity (accent = \u001b[94m0.80\u001b[m):\n\u001b[82D• \u001b[94mN1\u001b[m: \u001b[1mBD\u001b[m | \u001b[94mN2\u001b[m: \u001b[1mSD\u001b[m | \u001b[94mN3\u001b[m: \u001b[1mCH\u001b[m | \u001b[94mN4\u001b[m: \u001b[1mOH\u001b[m | \u001b[94mN5\u001b[m: \u001b[1mLT\u001b[m | \u001b[94mN6\u001b[m: \u001b[1mHT\u001b[m | \u001b[94mN7\u001b[m: \u001b[1mCP\u001b[m\r\n  • \u001b[1mRight Grid (Chord Keys \u001b[94;22mC1\u001b[39;1m–\u001b[94;22mC7\u001b[39;1m)\u001b[m: Triggers Voices 0–6 with full accent (accent = \u001b[94m1.00\u001b[m). Allows expressive two-\r\n  handed finger drumming and rolls.\r\n  • Sam\r\n⣻  \u001b[90mLoa\u001b[94m"]
