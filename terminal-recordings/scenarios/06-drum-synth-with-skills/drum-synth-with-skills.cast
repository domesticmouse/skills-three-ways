[0.034, "o", "\u001b[?2026h\r\u001b[27A\u001b[K\r\n   Voice Index | Name |       Engine       | Synthesis Method & Characteristics\u001b[K\r\n\u001b[?5W\u001b[J  -\u001b[12b|-\u001b[5b|-\u001b[19b|-\u001b[68b\r\n\t\u001b[1m0\u001b[m \u001b[5b|  \u001b[94mBD\u001b[m  | \u001b[34;4m\u001b]8;id=jk6d0296b2398072c5;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthbassdrum.h#L87\u0007SyntheticBassDrum\u001b[m\u001b]8;;\u0007  | 909-style bass drum with distorted sine shaper, punchy pitch sweep\n\u001b[96D| \u001b[5b|\u001b[20X\u001b[20C| envelope, and rich odd harmonics that cut through the internal\n\u001b[92D| \u001b[5b|\u001b[20X\u001b[20C| speakers.\r\n\t\u001b[1m1\u001b[m \u001b[5b|  \u001b[94mSD\u001b[m  | \u001b[34;4m\u001b]8;id=jke14709a45b228716;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthsnaredrum.h#L34\u0007SyntheticSnareDrum\u001b[m\u001b]8;;\u0007 | Dual-oscillator core with 1.47 mode ratio coupled with snappy\n\u001b[91D| \u001b[5b|\u001b[20X\u001b[20C| bandpass-filtered noise.\r\n\t\u001b[1m2\u001b[m \u001b[5b|  \u001b[94mCH\u001b[m  | \u001b[6b\u001b[34;4m\u001b]8;id=jk977ea6a9fe813e44;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/hihat.h#L117\u0007HiHat\u001b[m\u001b]8;;\u0007 \u001b[7b| 6-oscillator Schm"]
[0.000, "o", "itt trigger metallic cluster with tight decay.\n\u001b[93D| \u001b[5b|\u001b[20X\u001b[20C| Chokes open hat.\r\n\t\u001b[1m3\u001b[m \u001b[5b|  \u001b[94mOH\u001b[m  | \u001b[6b\u001b[34;4m\u001b]8;id=jk977e9da9fe812ef9;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/hihat.h#L117\u0007HiHat\u001b[m\u001b]8;;\u0007 \u001b[7b| Open metallic hi-hat sizzle. Automatically choked when Closed Hat\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| (\u001b[94mCH\u001b[m) is triggered.\r\n\t\u001b[1m4\u001b[m \u001b[5b|  \u001b[94mLT\u001b[m  | \u001b[5b\u001b[34;4m\u001b]8;id=jkfd67e1e1ab076597;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u0007TomVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Swept-sine low tom (88 Hz root) with 45 ms exponential pitch drop\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| and cubic body saturation.\r\n\t\u001b[1m5\u001b[m \u001b[5b|  \u001b[94mHT\u001b[m  | \u001b[5b\u001b[34;4m\u001b]8;id=jk9ecf09759d7a34bd;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u0007TomVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Swept-sine high tom (160 Hz root) with fast pitch drop and snappy\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| transient.\r\n\t\u001b[1m6\u001b[m \u001b[5b|  \u001b[94mCP\u001b[m  | \u001b[4b\u001b[34;4m\u001b]8;id=jk3b12eace9c73"]
[0.000, "o", "831;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L98-L186\u0007ClapVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Analog 808-style handclap: 3 distinct 11 ms noise bursts followed\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| by a 190 ms reverb tail through an 1150 Hz bandpass filter.\r\n  ──────\r\n  \u001b[1m### Hardware Control Mappings\u001b[m\r\n\n  \u001b[1m#### 1. Front Keys (7 Note Keys + 7 Chord Keys)\u001b[m\r\n\n  • \u001b[1mLeft Grid (Note Keys \u001b[94;22mN1\u001b[39;1m–\u001b[94;22mN7\u001b[39;1m)\u001b[m: Triggers Voices 0–6 at normal velocity (accent = \u001b[94m0.80\u001b[m):\n\u001b[82D• \u001b[94mN1\u001b[m\r\n\n⣷  \u001b[94mLo\u001b[90mading...\u001b[m\r\n\u001b[90m└ Tip: Use /fork to branch the conversation from an earlier point.\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b["]
