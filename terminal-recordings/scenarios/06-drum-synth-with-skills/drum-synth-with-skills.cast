[0.017, "o", "\u001b[?2026h\r\u001b[27A        \u001b[1m5\u001b[m      |  \u001b[94mHT\u001b[m  |      \u001b]8;id=jkf8bd88928885a13a;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u001b\\\u001b[4;34;4mT\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mm\u001b[m\u001b[4;34;4mV\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4me\u001b[m\u001b]8;;\u001b\\      | Swept-sine high tom (160 Hz root) with fast pitch drop and snappy\u001b[K\r\n               |      |                    | transient.\u001b[K\r\n\u001b[?5W\u001b[J\t\u001b[1m6\u001b[m \u001b[5b|  \u001b[94mCP\u001b[m  | \u001b[4b\u001b[34;4m\u001b]8;id=jk3efcf9a535dfef3c;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L98-L186\u0007ClapVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Analog 808-style handclap: 3 distinct 11 ms noise bursts followed\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| by a 190 ms reverb tail through an 1150 Hz bandpass filter.\r\n  ──────\r\n  \u001b[1m### Hardware Control Mappings\u001b[m\r\n\n  \u001b[1m#### 1. Front Keys (7 Note Keys + 7 Chord Keys)\u001b[m\r\n\n  • \u001b[1mLeft Grid (Note Keys \u001b[94;22mN1\u001b[39;1m–\u001b[94;22mN7\u001b[39;1m)\u001b[m: Triggers Voices 0–6 at normal velocity (accent = \u001b[94m0.80\u001b[m):\n\u001b[82D"]
[0.000, "o", "• \u001b[94mN1\u001b[m: \u001b[1mBD\u001b[m | \u001b[94mN2\u001b[m: \u001b[1mSD\u001b[m | \u001b[94mN3\u001b[m: \u001b[1mCH\u001b[m | \u001b[94mN4\u001b[m: \u001b[1mOH\u001b[m | \u001b[94mN5\u001b[m: \u001b[1mLT\u001b[m | \u001b[94mN6\u001b[m: \u001b[1mHT\u001b[m | \u001b[94mN7\u001b[m: \u001b[1mCP\u001b[m\r\n  • \u001b[1mRight Grid (Chord Keys \u001b[94;22mC1\u001b[39;1m–\u001b[94;22mC7\u001b[39;1m)\u001b[m: Triggers Voices 0–6 with full accent (accent = \u001b[94m1.00\u001b[m). Allows expressive two-\r\n  handed finger drumming and rolls.\r\n  • Sampled in a 1 kHz hardware timer ISR (\u001b[34;4m\u001b]8;id=jk1b18ee4d8a525653;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L254-L298\u0007TimerCallback\u001b[m\u001b]8;;\u0007) with lock-free queueing to eliminate missed presses\r\n  during OLED updates.\r\n\n  \u001b[1m#### 2. Top Knobs (Master Filter & Saturation Chain)\u001b[m\r\n\n  Wipers are sampled from ADC1, inverted for clockwise increase, and smoothed with an IIR filter:\r\n\n  • \u001b[1mKnob 1 (Chord Vol / \u001b[94;22mD18\u001b[39;1m)\u001b[m: \u001b[1mLow-Pass Cutoff\u001b[m (sweeps 35 Hz to 18 kHz exponentially).\r\n  • \u001b[1mKnob 2 (Chord Filter / \u001b[94;22mD17\u001b[39;1m)\u001b[m: \u001b[1mFilter Resonance\u001b[m (sweeps Q from 5% to 9"]
[0.000, "o", "6%).\r\n  • \u001b[1mKnob 3 (Notes Vol / \u001b[94;22mD19\u001b[39;1m)\u001b[m: \u001b[1mHigh-Pass Cutoff\u001b[m (sweeps 20 Hz to 5.5 kHz for DJ-style bass roll-offs).\r\n  • \u001b[1mKnob 4 (Notes Filter / \u001b[94;22mD20\u001b[39;1m)\u001b[m: \u001b[1mMaster Overdrive\u001b[m (warm analog saturation to aggressive punch).\r\n\n  \u001b[1m### \u001b[m\r\n⣟  \u001b[94mLoad\u001b[90ming...\u001b[m\r\n\u001b[90m└ Tip: Use /fork to branch the conversation from an earlier point.\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m──────────────────────────────────────────────────────────────────────────────────────"]
