[0.016, "o", "\u001b[?2026h\r\u001b[27A  ──────\u001b[K\r\n\u001b[?5W\u001b[J  \u001b[1m### Sound Architecture: 7 Drum Voices\u001b[m\r\n\n  All voices are synthesized in real-time in \u001b[34;4m\u001b]8;id=jk9076545346a51494;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L303-L417\u0007AudioCallback\u001b[m\u001b]8;;\u0007 without runtime heap allocations or unstable runaway\r\n  resonances:\r\n\n   Voice Index | Name | \u001b[6bEngine \u001b[6b| Synthesis Method & Characteristics\r\n  -\u001b[12b|-\u001b[5b|-\u001b[19b|-\u001b[68b\r\n\t\u001b[1m0\u001b[m \u001b[5b|  \u001b[94mBD\u001b[m  | \u001b[34;4m\u001b]8;id=jkf87bc4f2ce1c8dc8;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthbassdrum.h#L87\u0007SyntheticBassDrum\u001b[m\u001b]8;;\u0007  | 909-style bass drum with distorted sine shaper, punchy pitch sweep\n\u001b[96D| \u001b[5b|\u001b[20X\u001b[20C| envelope, and rich odd harmonics that cut through the internal\n\u001b[92D| \u001b[5b|\u001b[20X\u001b[20C| speakers.\r\n\t\u001b[1m1\u001b[m \u001b[5b|  \u001b[94mSD\u001b[m  | \u001b[34;4m\u001b]8;id=jk5490a88b74a4d59d;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/synthsnaredrum.h#L34\u0007SyntheticSnareDrum\u001b"]
[0.000, "o", "[m\u001b]8;;\u0007 | Dual-oscillator core with 1.47 mode ratio coupled with snappy\n\u001b[91D| \u001b[5b|\u001b[20X\u001b[20C| bandpass-filtered noise.\r\n\t\u001b[1m2\u001b[m \u001b[5b|  \u001b[94mCH\u001b[m  | \u001b[6b\u001b[34;4m\u001b]8;id=jk66e73f239d96ddf3;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/hihat.h#L117\u0007HiHat\u001b[m\u001b]8;;\u0007 \u001b[7b| 6-oscillator Schmitt trigger metallic cluster with tight decay.\n\u001b[93D| \u001b[5b|\u001b[20X\u001b[20C| Chokes open hat.\r\n\t\u001b[1m3\u001b[m \u001b[5b|  \u001b[94mOH\u001b[m  | \u001b[6b\u001b[34;4m\u001b]8;id=jk66e74c239d96f40a;file:///Users/brett/tmp/drum-synth-with-skills/workspace/DaisySP/Source/Drums/hihat.h#L117\u0007HiHat\u001b[m\u001b]8;;\u0007 \u001b[7b| Open metallic hi-hat sizzle. Automatically choked when Closed Hat\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| (\u001b[94mCH\u001b[m) is triggered.\r\n\t\u001b[1m4\u001b[m \u001b[5b|  \u001b[94mLT\u001b[m  | \u001b[5b\u001b[34;4m\u001b]8;id=jka2c9279f0475fce8;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u0007TomVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Swept-sine low tom (88 Hz root) with 45 ms exponential pitch drop\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| and cubic body saturation.\r\n\t\u001b[1m5\u001b[m \u001b[5b|  \u001b[94m"]
[0.000, "o", "HT\u001b[m  | \u001b[5b\u001b[34;4m\u001b]8;id=jk11b01b349465c020;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L29-L93\u0007TomVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Swept-sine high tom (160 Hz root) with fast pitch drop and snappy\n\u001b[95D| \u001b[5b|\u001b[20X\u001b[20C| transient.\r\n\t\u001b[1m6\u001b[m \u001b[5b|  \u001b[94mCP\u001b[m  | \u001b[4b\u001b[34;4m\u001b]8;id=jk4b094764a765c55a;file:///Users/brett/tmp/drum-synth-with-skills/workspace/drum_synth/main.cpp#L98-L186\u0007ClapVoice\u001b[m\u001b]8;;\u0007 \u001b[5b| Anal\r\n\n\n\n⣟  \u001b[90mLoading...\u001b[m\r\n\u001b[90m└ Tip: Use /fork to branch the conversation from an earlier point.\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m──────────────────────────────────"]
