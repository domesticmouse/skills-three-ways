[0.050, "o", "\u001b[?2026h\r\u001b[27A      \u001b]8;id=jk9c332660aabe75e0;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dcblock.h#L18\u001b\\\u001b[4;34;4md\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4my\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4mD\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4mB\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4mk\u001b[m\u001b]8;;\u001b\\.\u001b[K\r\n\u001b[?5W\u001b[J  2. \u001b[1mPhase 0: Non-Destructive Firmware Backup\u001b[m\n\u001b[39D• Boot into STM32 ROM DFU via \u001b[94mBOOT\u001b[m + \u001b[94mRESET\u001b[m.\n\u001b[43D• Check RDP protection level; dump Internal Flash (128 KB @ \u001b[94m0x080\u001b[5b\u001b[m) and QSPI Flash (8 MB @ \u001b[94m0x90\u001b[6b\u001b[m)\r\n\u001b[6Cvia \u001b[94mdfu-util\u001b[m.\n\u001b[13D• Archive SHA-256 hashes and analyze binary strings for peripheral identifiers.\r\n  3. \u001b[1mPhase 1: Safe Tooling & Non-Blocking USB CDC Shell\u001b[m\n\u001b[49D• Target Gamma's USB-C port routed to pins \u001b[94mD29\u001b[m/\u001b[94mD30\u001b[m (\u001b[94mUsbHandle::FS_EXTERNAL\u001b[m).\n\u001b[76D• Implement a microsecond-guarded non-blocking logger using \u001b[34;4m\u001b]8;id=jk5ae0e5f2f27845a;file:///Users/brett/tmp/workspace/libDaisy/sr"]
[0.000, "o", "c/sys/system.h\u0007System::GetUs()\u001b[m\u001b]8;;\u0007 to eliminate the \u001b[34;4m\u001b]8;id=jk98bb318861d06fb7;file:///Users/brett/tmp/workspace/libDaisy/src/hid/logger.h#L192\u0007Logger\u001b[m\u001b]8;;\u0007\n\u001b[99Dsynchronous deadlock hazard.\r\n  4. \u001b[1mPhase 2: I2C Bus Scanning & Subsystem Detection\u001b[m\n\u001b[46D• Execute SCL bus-recovery clocking (9 pulses to clear hung SDA lines).\n\u001b[71D• Sweep 7-bit addresses (\u001b[94m0x08\u001b[m to \u001b[94m0x77\u001b[m) using \u001b[34;4m\u001b]8;id=jkc84eb6d1c0a85aa5;file:///Users/brett/tmp/workspace/libDaisy/src/per/i2c.h#L25\u0007I2CHandle\u001b[m\u001b]8;;\u0007 to detect OLED displays (\u001b[94m0x3C\u001b[m/\u001b[94m0x3D\u001b[m), port expanders\r\n\u001b[6C(\u001b[94m0x20\u001b[m–\u001b[94m0x27\u001b[m), or touch ICs (\u001b[94m0x5A\u001b[m–\u001b[94m0x5D\u001b[m).\r\n  5. \u001b[1mPhase 3: ADC Potentiometer & Joystick Mapping\u001b[m\n\u001b[44D• Configure all 14 analog channels (\u001b[94mA0\u001b[m–\u001b[94mA11\u001b[m plus Daisy Seed 2 DFM pins \u001b[94mA12\u001b[m/\u001b[94mD31\u001b[m and \u001b[94mA13\u001b[m/\u001b[94mD32\u001b[m) via \u001b[34;4m\u001b]8;id=jkc58edf2dd2d1d5e9;file:///Users/brett/tmp/workspace/libDaisy/src/per/adc.h#L10\u0007AdcHandle\u001b[m\u001b]8;;\u0007.\r\n\u001b[6C• Stream 16-bit ra"]
