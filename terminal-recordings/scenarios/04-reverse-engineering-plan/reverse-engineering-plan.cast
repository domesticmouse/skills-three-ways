[0.017, "o", "\u001b[?2026h\u001b[26A\u001b[71C\u001b[34;4m\u001b]8;id=jk3f8447f5a32752f6;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L27\u0007GPIO::Mode::INPUT\u001b[m\u001b]8;;\u0007 or \u001b[34;4m\u001b]8;id=jk1bb9f9ef4648d885;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L30\u0007GPIO::Mode::ANALOG\u001b[m\u001b]8;;\u0007\n\n\u001b[31D\u001b[34;4m\u001b]8;id=jkb8c89bf5e7d692fe;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L29\u0007GPIO::Mode::OPEN_DRAIN\u001b[m\u001b]8;;\u0007\n\n\u001b[27D\u001b[34;4m\u001b]8;id=jk7f4329cc2389fa5f;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dsp.h#L115\u0007daisysp::SoftLimit\u001b[m\u001b]8;;\u0007\n\u001b[88D\u001b[34;4m\u001b]8;id=jk1597208555282055;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dcblock.h#L18\u0007daisysp::DcBlock\u001b[m\u001b]8;;\u0007\n\n\n\n\n\n\n\n\u001b[44C\u001b[34;4m\u001b]8;id=jk5ef03e42e20b4e61;file:///Users/brett/tmp/workspace/libDaisy/src/sys/system.h\u0007System::GetUs()\u001b[m\u001b]8;;\u0007 to eliminate the \u001b[34;4m\u001b]8;id=jk85661911581733d2;file:///Users/brett/tmp/workspace/libDaisy/src/hid/logger.h#L192\u0007Logger\u001b[m\u001b]8;;\u0007\n\n\n\n\u001b[54D\u001b[34;4m\u001b]8;id=jk86881322971ef788;file:///Users/brett/tmp/workspace/libDaisy/src/per/i2"]
