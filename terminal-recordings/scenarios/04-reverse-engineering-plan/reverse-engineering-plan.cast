[0.017, "o", "\u001b[?2026h\r\u001b[27A      • \u001b[1mOpen-Drain Matrix Rule:\u001b[m Candidate key-matrix rows are strictly driven in \u001b]8;id=jk2c393f175bfb6e19;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L29\u001b\\\u001b[4;34;4mG\u001b[m\u001b[4;34;4mP\u001b[m\u001b[4;34;4mI\u001b[m\u001b[4;34;4mO\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4mM\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4m:\u001b[m\u001b[4;34;4mO\u001b[m\u001b[4;34;4mP\u001b[m\u001b[4;34;4mE\u001b[m\u001b[4;34;4mN\u001b[m\u001b[4;34;4m_\u001b[m\u001b[4;34;4mD\u001b[m\u001b[4;34;4mR\u001b[m\u001b[4;34;4mA\u001b[m\u001b[4;34;4mI\u001b[m\u001b[4;34;4mN\u001b[m\u001b]8;;\u001b\\ with\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6Cpull-up inputs to prevent V_{CC}–to–GND contention during simultaneous keypresses.\n\u001b[82D• \u001b[1mAcoustic Limiting:\u001b[m Test tone generation is clamped at -20 dBFS with \u001b[34;4m\u001b]8;id=jk48c599fc138094b6;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dsp.h#L115\u0007daisysp::SoftLimit\u001b[m\u001b]8;;\u0007 and\n\u001b[92D\u001b[34;4m\u001b]8;id=jk619489a94550f762;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dcblock.h#L18\u0007daisysp::DcBlock\u001b[m\u001b]8;;\u0007.\r\n  2. \u001b[1mPhase 0: Non-Destructive Firmware Backup\u001b[m\n\u001b[39D• Boot into STM"]
[0.000, "o", "32 ROM DFU via \u001b[94mBOOT\u001b[m + \u001b[94mRESET\u001b[m.\n\u001b[43D• Check RDP protection level; dump Internal Flash (128 KB @ \u001b[94m0x080\u001b[5b\u001b[m) and QSPI Flash (8 MB @ \u001b[94m0x90\u001b[6b\u001b[m)\r\n\u001b[6Cvia \u001b[94mdfu-util\u001b[m.\n\u001b[13D• Archive SHA-256 hashes and analyze binary strings for peripheral identifiers.\r\n  3. \u001b[1mPhase 1: Safe Tooling & Non-Blocking USB CDC Shell\u001b[m\n\u001b[49D• Target Gamma's USB-C port routed to pins \u001b[94mD29\u001b[m/\u001b[94mD30\u001b[m (\u001b[94mUsbHandle::FS_EXTERNAL\u001b[m).\n\u001b[76D• Implement a microsecond-guarded non-blocking logger using \u001b[34;4m\u001b]8;id=jk6729048ada6b1404;file:///Users/brett/tmp/workspace/libDaisy/src/sys/system.h\u0007System::GetUs()\u001b[m\u001b]8;;\u0007 to eliminate the \u001b[34;4m\u001b]8;id=jk24b975bb85b28b51;file:///Users/brett/tmp/workspace/libDaisy/src/hid/logger.h#L192\u0007Logger\u001b[m\u001b]8;;\u0007\n\u001b[99Dsynchronous deadlock hazard.\r\n  4. \u001b[1mPhase 2: I2C Bus Scanning & Subsystem Detection\u001b[m\n\u001b[46D• Execute SCL bus-recovery clocking (9 pulses to clear hung SDA lines).\n\u001b[71D• Sweep 7-bit addresses (\u001b[94m0x08\u001b[m to \u001b[94m0x77\u001b[m) using \u001b[34;4m\u001b"]
[0.000, "o", "]8;id=jka6b5b6e44323ce93;file:///Users/brett/tmp/workspace/libDaisy/src/per/i2c.h#L25\u0007I2CHandle\u001b[m\u001b]8;;\u0007 to detect OLED displays (\u001b[94m0x3C\u001b[m/\u001b[94m0x3D\u001b[m), port expanders\r\n\u001b[6C(\u001b[94m0x20\u001b[m–\u001b[94m0x27\u001b[m), or touch ICs (\u001b[94m0x5A\u001b[m–\u001b[94m0x5D\u001b[m).\r\n  5. \u001b[1mPhase 3: ADC Potentiometer & Joystick Mapping\u001b[m\n\u001b[44D• Configure all 14 analog channels (\u001b[94mA0\u001b[m–\u001b[94mA11\u001b[m plus Daisy Seed 2 DFM pins \u001b[94mA12\u001b[m/\u001b[94mD31\u001b[m and \u001b[94mA13\u001b[m/\u001b[94mD32\u001b[m) via \u001b[34;4m\u001b]8;id=jkf06cad2bcea8afb3;file:///Users/brett/tmp/workspace/libDaisy/src/per/adc.h#L10\u0007AdcHandle\u001b[m\u001b]8;;\u0007.\r\n\u001b[6C• Stream 16-bit raw values to identify rotary pots, self-centering joysticks, and floating lines; condition\r\n\u001b[6Cwith \u001b[34;4m\u001b]8;id=jkb9f0e803bdc0d5cc;file:///Users/brett/tmp/workspace/libDaisy/src/hid/parameter.h#L19\u0007daisysp::Parameter\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk681a1f231de95596;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dsp.h#L113\u0007daisysp::fmap\u001b[m\u001b]8;;\u0007.\r\n  6. \u001b[1mPhase 4: Digital Key & Matrix Scanning\u001b[m\n\u001b[37D• Dif"]
