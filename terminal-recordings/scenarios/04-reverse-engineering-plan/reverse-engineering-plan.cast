[0.017, "o", "\u001b[?2026h\u001b[27A\u001b[88C\u001b[34;4m\u001b]8;id=jka532ca9b52977bed;file:///Users/brett/tmp/workspace/PLAN.md\u0007PLAN.md\u001b[m\u001b]8;;\u0007\n\n\n\n\n\u001b[24D\u001b[34;4m\u001b]8;id=jka6c9e8eec1e75ac8;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L27\u0007GPIO::Mode::INPUT\u001b[m\u001b]8;;\u0007 or \u001b[34;4m\u001b]8;id=jkb9c6ee5dd69fceb;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L30\u0007GPIO::Mode::ANALOG\u001b[m\u001b]8;;\u0007\n\n\u001b[31D\u001b[34;4m\u001b]8;id=jk72d0e4eea4772900;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L29\u0007GPIO::Mode::OPEN_DRAIN\u001b[m\u001b]8;;\u0007\n\n\u001b[27D\u001b[34;4m\u001b]8;id=jk8796aaf6bbd29b01;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dsp.h#L115\u0007daisysp::SoftLimit\u001b[m\u001b]8;;\u0007\n\u001b[88D\u001b[34;4m\u001b]8;id=jk100742462f2510a7;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dcblock.h#L18\u0007daisysp::DcBlock\u001b[m\u001b]8;;\u0007\n\n\n\n\n\n\n\n\u001b[44C\u001b[34;4m\u001b]8;id=jka5c1bf21067aedc3;file:///Users/brett/tmp/workspace/libDaisy/src/sys/system.h\u0007System::GetUs()\u001b[m\u001b]8;;\u0007 to eliminate the \u001b[34;4m\u001b]8;id=jkafcb15552594d874;file:///Users/brett/tmp/workspace/libDaisy/src/hid/logger.h#L192\u0007Logger\u001b[m\u001b"]
