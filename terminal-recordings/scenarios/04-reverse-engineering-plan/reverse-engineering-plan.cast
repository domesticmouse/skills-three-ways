[0.017, "o", "\u001b[?2026h\r\u001b[27A  1. \u001b[1mSafety Interlocks & Anti-Contention Rules\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6C• \u001b[1mHigh-Impedance Default:\u001b[m All unverified pins remain configured as \u001b[34;4m\u001b]8;id=jk2d505360f92b30ec;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L27\u0007GPIO::Mode::INPUT\u001b[m\u001b]8;;\u0007 or \u001b[34;4m\u001b]8;id=jk620641588a6d7cb7;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L30\u0007GPIO::Mode::ANALOG\u001b[m\u001b]8;;\u0007\r\n\u001b[6Cto prevent shorts or damaged driver pads.\n\u001b[41D• \u001b[1mOpen-Drain Matrix Rule:\u001b[m Candidate key-matrix rows are strictly driven in \u001b[34;4m\u001b]8;id=jk3ea32f6102fb0214;file:///Users/brett/tmp/workspace/libDaisy/src/per/gpio.h#L29\u0007GPIO::Mode::OPEN_DRAIN\u001b[m\u001b]8;;\u0007 with\r\n\u001b[6Cpull-up inputs to prevent V_{CC}–to–GND contention during simultaneous keypresses.\n\u001b[82D• \u001b[1mAcoustic Limiting:\u001b[m Test tone generation is clamped at -20 dBFS with \u001b[34;4m\u001b]8;id=jk775cb903913fc82d;file:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dsp.h#L115\u0007daisysp::SoftLimit\u001b[m\u001b]8;;\u0007 and\n\u001b[92D\u001b[34;4m\u001b]8;id=jkf732f87c83ee81c3;f"]
[0.000, "o", "ile:///Users/brett/tmp/workspace/DaisySP/Source/Utility/dcblock.h#L18\u0007daisysp::DcBlock\u001b[m\u001b]8;;\u0007.\r\n  2. \u001b[1mPhase 0: Non-Destructive Firmware Backup\u001b[m\n\u001b[39D• Boot into STM32 ROM DFU via \u001b[94mBOOT\u001b[m + \u001b[94mRESET\u001b[m.\n\u001b[43D• Check RDP protection level; dump Internal Flash (128 KB @ \u001b[94m0x080\u001b[5b\u001b[m) and QSPI Flash (8 MB @ \u001b[94m0x90\u001b[6b\u001b[m)\r\n\u001b[6Cvia \u001b[94mdfu-util\u001b[m.\n\u001b[13D• Archive SHA-256 hashes and analyze binary strings for peripheral identifiers.\r\n  3. \u001b[1mPhase 1: Safe Tooling & Non-Blocking USB CDC Shell\u001b[m\n\u001b[49D• Target Gamma's USB-C port routed to pins \u001b[94mD29\u001b[m/\u001b[94mD30\u001b[m (\u001b[94mUsbHandle::FS_EXTERNAL\u001b[m).\n\u001b[76D• Implement a microsecond-guarded non-blocking logger using \u001b[34;4m\u001b]8;id=jk15945a8df98b6e9f;file:///Users/brett/tmp/workspace/libDaisy/src/sys/system.h\u0007System::GetUs()\u001b[m\u001b]8;;\u0007 to eliminate the \u001b[34;4m\u001b]8;id=jk146aa04c2f37590;file:///Users/brett/tmp/workspace/libDaisy/src/hid/logger.h#L192\u0007Logger\u001b[m\u001b]8;;\u0007\n\u001b[99Dsynchronous deadlock hazard.\r\n  4. \u001b[1mPhase 2: I2C Bus Scanning & Subsys"]
[0.000, "o", "tem Detection\u001b[m\n\u001b[46D• Execute SCL bus-recovery clocking (9 pulses to clear hung SDA lines).\n\u001b[71D• Sweep 7-bit addresses (\u001b[94m0x08\u001b[m to \u001b[94m0x77\u001b[m) using \u001b[34;4m\u001b]8;id=jkf82f89fc526f90f2;file:///Users/brett/tmp/workspace/libDaisy/src/per/i2c.h#L25\u0007I2CHandle\u001b[m\u001b]8;;\u0007 to detect OLED displays (\u001b[94m0x3C\u001b[m/\u001b[94m0x3D\u001b[m), port expanders\r\n\u001b[6C(\u001b[94m0x20\u001b[m–\u001b[94m0x27\u001b[m), or touch ICs (\u001b[94m0x5A\u001b[m–\u001b[94m0x5D\u001b[m).\r\n  5. \u001b[1mPhase 3: ADC Potentiometer & Joystick Mapping\u001b[m\n\u001b[44D• Configure all 14 analog channels (\u001b[94mA0\u001b[m–\u001b[94mA11\u001b[m plus Daisy Seed 2 DFM pins \u001b[94mA12\u001b[m/\u001b[94mD31\u001b[m and \u001b[94mA13\u001b[m/\u001b[94mD32\u001b[m) via \u001b[34;4m\u001b]8;id=jkf65c4399b0d387ac;file:///Users/brett/tmp/workspace/libDaisy/src/per/adc.h#L10\u0007AdcHandle\u001b[m\u001b]8;;\u0007.\r\n\u001b[6C• Stream 16-bit raw values to identify rotary pots, self-centering joysticks, and floating lines; condition\r\n\u001b[6Cwith\r\n\n⣷  \u001b[90mL\u001b[94moadin\u001b[90mg...\u001b[m\r\n\u001b[90m└ Tip: Use /voice (or press f5) to record your prompt with your microphone.\u001b[m\r\n\u001b[90m──────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[90mesc to cancel\u001b[m\u001b[80X\u001b[80C\u001b[2mGemini 3.8 Flash · high\u001b[m\r\u001b[2A\u001b[2C\u001b[?2026l"]
